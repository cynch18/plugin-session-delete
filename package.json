{
  "name": "dsh-profile-plugin-session-delete",
  "version": "0.1.0",
  "description": "DSH web plugin: native sidebar batch-delete for sessions (header button + row checkboxes) with self-healing slot patch.",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": ["dsh-plugin", "dsh", "session", "delete"]
}
